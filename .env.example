# Copy to .env and fill in. Nothing in this repo reads secrets from anywhere else,
# and .env is gitignored -- never commit real values.

# LLM cascade: Anthropic (if keyed) → Ollama (local/free) → rule-based heuristics.
# 1) Anthropic / Claude — leave blank to skip
ANTHROPIC_API_KEY=
ANTHROPIC_BULK_MODEL=claude-3-5-haiku-latest
ANTHROPIC_REASONING_MODEL=claude-opus-4-latest

# 2) Ollama — free local LLM, no API key. Install from https://ollama.com
#    then:  ollama pull llama3.2
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# 3) If both Anthropic and Ollama fail / are unavailable, agents use heuristic logic.

# Google PageSpeed Insights. If unset, Core Web Vitals are reported as "assumed" heuristics.
PSI_API_KEY=

# GitHub. Fine-grained PAT scoped to a single repo, with contents (read/write),
# pull-requests (read/write), metadata (read) only. If unset, Phase 2-4 are skipped.
GITHUB_TOKEN=
GITHUB_REPO=            # e.g. "my-org/my-site"
GITHUB_BOT_IDENTITY=seo-agent-bot

# Vector store (Chroma persists to disk locally by default; no key needed)
CHROMA_PERSIST_DIR=./chroma_db

# Run limits
MAX_PAGES_PER_CRAWL=50
LLM_TOKEN_BUDGET_PER_RUN=200000

# Backend
BACKEND_PORT=8000
